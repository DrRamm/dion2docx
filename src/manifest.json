{
  "manifest_version": 3,
  "name": "Dion Chat → DOCX",
  "version": "0.1.2",
  "description": "Экспорт чата dion.vc в DOCX: автор, время, текст, ответы и картинки.",
  "permissions": ["downloads", "offscreen", "scripting"],
  "host_permissions": ["https://dion.vc/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Dion Chat → DOCX",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://dion.vc/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
